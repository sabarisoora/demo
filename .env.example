# Postgres connection string. On Vercel, add the Neon integration (free) and it sets this for you.
DATABASE_URL=postgres://profitiqs:profitiqs@localhost:5432/profitiqs

# Public URL of the app (used in links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Digistore24 — Elite subscription product
# The product ID shown in your DS24 product list (used to build the checkout link).
NEXT_PUBLIC_DS24_ELITE_PRODUCT_ID=
# Comma-separated list of every DS24 product ID that should unlock Elite
# (e.g. the monthly + yearly Elite plans). Defaults to the ID above.
DS24_ELITE_PRODUCT_IDS=
# DS24 > Settings > Integrations (IPN) > "SHA passphrase". Required — IPN calls are rejected without it.
DS24_IPN_PASSPHRASE=
# Shown on the landing and upgrade pages, e.g. "$29/mo" (in a local .env file, write \$ for a dollar sign;
# on Vercel type it normally). Leave blank to hide.
NEXT_PUBLIC_ELITE_PRICE_LABEL=

# ── Email (password reset + email confirmation) ──────────────────────────────
# Free at https://resend.com (3,000 emails/month). Without a key, emails are only printed to the logs.
RESEND_API_KEY=
# Sender, after verifying your domain in Resend, e.g. ProfitIQS <hello@profitiqs.com>.
# Until then leave blank: Resend's test sender only delivers to your own Resend account email.
EMAIL_FROM=
# Set to "log" to write emails to the server log instead of sending (testing only).
EMAIL_TRANSPORT=

# Protects the daily weekly-summary job (/api/cron/weekly-digest). Any long random string;
# Vercel sends it automatically on cron calls once this variable exists.
CRON_SECRET=

# ── Owner / admin ─────────────────────────────────────────────────────────────
# Comma-separated emails that can open /admin (the account's email must be confirmed).
ADMIN_EMAILS=

# ── Business details shown on legal pages and emails ─────────────────────────
NEXT_PUBLIC_COMPANY_NAME=ProfitIQS
NEXT_PUBLIC_SUPPORT_EMAIL=support@profitiqs.com
NEXT_PUBLIC_GOVERNING_LAW=India
# Money-back guarantee window in days (match what you set on the Digistore24 product).
NEXT_PUBLIC_REFUND_DAYS=30
