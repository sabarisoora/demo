# Postgres connection string. On Vercel, add the Neon integration (free) and it sets this for you.
DATABASE_URL=postgres://profitiqs:profitiqs@localhost:5432/profitiqs

# Public URL of the app (used in links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Digistore24 — Elite subscription product
# The product ID shown in your DS24 product list (used to build the checkout link).
NEXT_PUBLIC_DS24_ELITE_PRODUCT_ID=
# Comma-separated list of every DS24 product ID that should unlock Elite
# (e.g. the monthly + yearly Elite plans). Defaults to the ID above.
DS24_ELITE_PRODUCT_IDS=
# DS24 > Settings > Integrations (IPN) > "SHA passphrase". Required — IPN calls are rejected without it.
DS24_IPN_PASSPHRASE=
# Shown on the landing and upgrade pages, e.g. "$29/mo" (in a local .env file, write \$ for a dollar sign;
# on Vercel type it normally). Leave blank to hide.
NEXT_PUBLIC_ELITE_PRICE_LABEL=
